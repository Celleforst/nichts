+/*
+ * Touch controller constellation (camera-based) tracking.
+ *
+ * Unlike the HMD, Touch controllers were never wired into the constellation tracker at all --
+ * only orientation (from the controller's own IMU, relayed over radio) was ever tracked, position
+ * was simply never set. The controller's LED geometry needed to fix that was already being parsed
+ * from its calibration data (rift_touch_calibration_parse) for other purposes (joystick/trigger
+ * ranges, IMU calibration matrices) -- it just wasn't being handed to the constellation tracker.
+ */
+
+static void
+rift_touch_controller_build_led_model(struct rift_touch_controller *controller)
+{
+	struct rift_touch_controller_calibration *c = &controller->input.calibration;
+
+	controller->led_model.match_parameters = (struct t_constellation_tracker_led_model_match_parameters){
+	    // Confirmed via the registration log (24 LEDs on both controllers, every session) --
+	    // the HMD's own thresholds are roughly 25% of its ~34 LEDs, so 6/4 was already in that
+	    // ballpark, but the controller's LEDs sit in a ring: only ever about half face a given
+	    // camera, and real-world occlusion (fingers, the other hand, the HMD itself) eats into
+	    // that further. Nudged a bit more lenient, since the observed failure mode is "won't
+	    // lock" rather than "locks onto the wrong thing".
+	    .min_leds_for_correspondence_search_without_prior = 5,
+	    .min_leds_for_correspondence_search_with_prior = 3,
+	};
+
+	controller->led_model.leds = U_TYPED_ARRAY_CALLOC(struct t_constellation_tracker_led, c->num_leds);
+	controller->led_model.led_count = 0;
+
+	for (size_t i = 0; i < c->num_leds; i++) {
+		struct xrt_vec3 pos = {
+		    c->leds[i].position.x - c->imu_position.x,
+		    c->leds[i].position.y - c->imu_position.y,
+		    c->leds[i].position.z - c->imu_position.z,
+		};
+		struct xrt_vec3 normal = c->leds[i].normal;
+
+		// Same coordinate-system flip the HMD applies to its own calibration data, which comes
+		// from the same manufacturer format (see rift_read_led_model in rift_driver.c).
+		pos.x = -pos.x;
+		pos.z = -pos.z;
+		normal.x = -normal.x;
+		normal.z = -normal.z;
+		math_vec3_normalize(&normal);
+
+		controller->led_model.leds[controller->led_model.led_count++] = (struct t_constellation_tracker_led){
+		    .position = pos,
+		    .normal = normal,
+		    .radius_m = 0.0035f, // 3.5mm, same as the HMD's LEDs
+		    .visibility_angle = DEG_TO_RAD(90.0f),
+		    .id = (t_constellation_led_id_it)i,
+		};
+	}
+}
+
+static void
+rift_touch_controller_constellation_device_push_sample(struct t_constellation_tracker_device *connection,
+                                                        struct t_constellation_tracker_sample *sample)
+{
+	// No-op: rift_touch_controller_get_tracked_pose queries the tracker directly for each pose
+	// request instead of consuming a pushed stream, same as the HMD's primary pose path
+	// (get_raw_pose in rift_driver.c). Still required to satisfy the device interface.
+}
+
+static void
+rift_touch_controller_add_to_constellation_tracker(struct rift_touch_controller *controller)
+{
+	if (controller->constellation_tracker != NULL) {
+		return; // already added
+	}
+
+	// The HMD registers itself with the tracker as soon as it's created; controllers join later,
+	// asynchronously, once their calibration (and hence LED model) has arrived over radio.
+	struct t_constellation_tracker *tracker = controller->hmd->constellation_tracker;
+	if (tracker == NULL) {
+		return;
+	}
+
+	rift_touch_controller_build_led_model(controller);
+
+	controller->constellation_device.push_constellation_tracker_sample =
+	    rift_touch_controller_constellation_device_push_sample;
+
+	struct t_constellation_tracker_device_params params = {
+	    .led_model = controller->led_model,
+	    // Anchor correspondence search with the HMD's own current pose -- the controller is
+	    // almost always somewhere near it, which should help disambiguate blobs faster than
+	    // searching cold, and is intended to help with the frequent "mismatched LED id" rejections
+	    // seen without a prior.
+	    .tracking_source = &controller->hmd->constellation_tracking_source,
+	};
+
+	int ret = t_constellation_tracker_add_device(tracker, &params, &controller->constellation_device,
+	                                             &controller->constellation_device_id);
+	if (ret < 0) {
+		HMD_ERROR(controller->hmd, "Failed to add touch controller %d to constellation tracker: %d",
+		         controller->device_type, ret);
+		free(controller->led_model.leds);
+		controller->led_model.leds = NULL;
+		return;
+	}
+
+	controller->constellation_tracker = tracker;
+	controller->constellation_imu_sink = params.imu_sink;
+	controller->use_constellation_poses = true;
+
+	HMD_INFO(controller->hmd, "Touch controller %d added to constellation tracker (device id %d, %zu LEDs)",
+	        controller->device_type, controller->constellation_device_id, controller->led_model.led_count);
+}
